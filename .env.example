# 复制为 .env 后按需修改。docker compose 和本地开发都会读取这里的值。

# 数据库（docker compose 会用这三项创建数据库）
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_password
POSTGRES_DB=crm
# docker compose 对本机开放的数据库端口；和本机已有的 PostgreSQL 冲突时改成 5433，并同步修改下面两个连接串
POSTGRES_PORT=5432

# 后端连接串。本地直接跑 pnpm dev 时用 localhost；docker compose 内部会自动改成 postgres 主机名
DATABASE_URL=postgresql://crm:crm_local_password@localhost:5432/crm?schema=public
# 接口测试（pnpm test:e2e）专用库，测试会清空它，千万别指向正式库
TEST_DATABASE_URL=postgresql://crm:crm_local_password@localhost:5432/crm_test?schema=public

# JWT 密钥：上云前务必换成至少 32 位的随机字符串（例如 openssl rand -hex 32 的结果）
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL_DAYS=7

# 首次初始化时创建的管理员账号（首次登录会强制改密码）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456

# 后端端口
API_PORT=3000
# 管理后台对外端口（docker compose）
ADMIN_PORT=8080
