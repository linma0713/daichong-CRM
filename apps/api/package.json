{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "description": "代充 CRM 后端服务（NestJS + Prisma + PostgreSQL）",
  "files": [
    "dist",
    "prisma",
    "docker-entrypoint.sh"
  ],
  "scripts": {
    "dev": "pnpm db generate && nest start --watch",
    "build": "pnpm db generate && nest build",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:e2e": "node --env-file-if-exists=../../.env node_modules/jest/bin/jest.js --config test/jest-e2e.config.js --runInBand",
    "prisma:generate": "pnpm db generate",
    "prisma:migrate": "pnpm db migrate dev",
    "prisma:deploy": "pnpm db migrate deploy && pnpm db generate",
    "prisma:seed": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only prisma/seed.ts",
    "openapi:export": "ts-node --transpile-only scripts/export-openapi.ts",
    "db": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js",
    "prisma:seed:prod": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
