// 代充 CRM 数据模型
// M0 只包含员工、角色、小组、登录会话和操作日志；业务表从 M1 开始逐步加入。
// 约定：主键用 cuid；金额一律存「分」（整数）；美元成本存原币金额 + 当时汇率。

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 数据范围：员工能看到哪些业务数据
enum DataScope {
  SELF
  TEAM
  ALL
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// 小组：用于「本小组数据」这种数据范围
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

/// 员工账号（客户和代理不登录系统）
model User {
  id                 String     @id @default(cuid())
  username           String     @unique
  displayName        String
  passwordHash       String
  status             UserStatus @default(ACTIVE)
  /// 管理员创建或重置密码后，首次登录必须改密码
  mustChangePassword Boolean    @default(true)
  teamId             String?
  team               Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  roles              UserRole[]
  sessions           Session[]
  auditLogs          AuditLog[]
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  /// 软删除：删除的员工保留历史记录
  deletedAt          DateTime?

  @@index([teamId])
}

/// 角色：一组权限 + 数据范围。一个员工可以有多个角色，权限取并集、范围取最大
model Role {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  permissions String[]
  dataScope   DataScope  @default(SELF)
  /// 内置角色不能删除
  builtIn     Boolean    @default(false)
  users       UserRole[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// 登录会话：保存刷新令牌的哈希，退出登录或重置密码时作废
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

/// 操作日志：谁、在什么时候、做了什么
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 动作，例如 user.create、auth.login
  action     String
  /// 给人看的说明，例如「新增员工」
  summary    String
  method     String?
  path       String?
  resourceId String?
  /// 请求内容（密码等敏感字段已脱敏）
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}
