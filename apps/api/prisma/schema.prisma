// 代充 CRM 数据模型
// M0：员工、角色、小组、登录会话、操作日志
// M1：客户、套餐与商品、订单与收款、开通任务、Claude 账号、订阅、业务设置
// M2：付款资源与库存流水、成品号库存、成本记录（每单毛利）、质保、售后工单、退款
// 约定：主键用 cuid；金额一律存「分」（整数）；美元金额存「美分」，换算人民币用当时汇率。
// 时间一律存 UTC，界面按北京时间显示。

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 数据范围：员工能看到哪些业务数据
enum DataScope {
  SELF
  TEAM
  ALL
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// 小组：用于「本小组数据」这种数据范围
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

/// 员工账号（客户和代理不登录系统）
model User {
  id                 String                @id @default(cuid())
  username           String                @unique
  displayName        String
  passwordHash       String
  status             UserStatus            @default(ACTIVE)
  /// 管理员创建或重置密码后，首次登录必须改密码
  mustChangePassword Boolean               @default(true)
  teamId             String?
  team               Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  roles              UserRole[]
  sessions           Session[]
  auditLogs          AuditLog[]
  ownedCustomers     Customer[]            @relation("CustomerOwner")
  ownedOrders        Order[]               @relation("OrderOwner")
  createdOrders      Order[]               @relation("OrderCreator")
  confirmedPayments  Payment[]
  assignedTasks      FulfillmentTask[]     @relation("TaskAssignee")
  ownedSubscriptions Subscription[]        @relation("SubscriptionOwner")
  followUps          FollowUp[]
  resourceTxs        ResourceTransaction[]
  costEntries        CostEntry[]
  assignedTickets    Ticket[]              @relation("TicketAssignee")
  ownedTickets       Ticket[]              @relation("TicketOwner")
  createdTickets     Ticket[]              @relation("TicketCreator")
  ticketEvents       TicketEvent[]
  requestedRefunds   Refund[]              @relation("RefundRequester")
  approvedRefunds    Refund[]              @relation("RefundApprover")
  lastLoginAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  /// 软删除：删除的员工保留历史记录
  deletedAt          DateTime?

  @@index([teamId])
}

/// 角色：一组权限 + 数据范围。一个员工可以有多个角色，权限取并集、范围取最大
model Role {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  permissions String[]
  dataScope   DataScope  @default(SELF)
  /// 内置角色不能删除
  builtIn     Boolean    @default(false)
  users       UserRole[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// 登录会话：保存刷新令牌的哈希，退出登录或重置密码时作废
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

/// 操作日志：谁、在什么时候、做了什么
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 动作，例如 user.create、auth.login
  action     String
  /// 给人看的说明，例如「新增员工」
  summary    String
  method     String?
  path       String?
  resourceId String?
  /// 请求内容（密码等敏感字段已脱敏）
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

// ───────────────────────────── M1 业务 ─────────────────────────────

/// 客户：终端用户。由负责客服跟进，ownerId / teamId 决定谁能看到
model Customer {
  id            String            @id @default(cuid())
  /// 客户编号，界面显示为 C00001
  no            Int               @unique @default(autoincrement())
  /// 称呼
  name          String
  wechat        String?
  telegram      String?
  email         String?
  phone         String?
  /// 来源：organic 自然流量 / referral 老客推荐 / agent 代理 / ads 投放 / other 其他
  source        String            @default("organic")
  /// 推荐人（老客户）
  referrerId    String?
  referrer      Customer?         @relation("CustomerReferral", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals     Customer[]        @relation("CustomerReferral")
  /// 绑定的代理：客户首单（或建档时）绑定，以后的订单都算这个代理的
  agentId       String?
  agent         Agent?            @relation(fields: [agentId], references: [id])
  agentBoundAt  DateTime?
  tags          String[]
  remark        String?
  ownerId       String
  owner         User              @relation("CustomerOwner", fields: [ownerId], references: [id])
  /// 负责人所在小组，用于「本小组数据」范围；换负责人时同步
  teamId        String?
  orders        Order[]
  subscriptions Subscription[]
  accounts      ClaudeAccount[]
  tasks         FulfillmentTask[]
  followUps     FollowUp[]
  tickets       Ticket[]
  refunds       Refund[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([ownerId])
  @@index([teamId])
  @@index([createdAt])
  @@index([agentId])
}

/// 客户跟进记录：沟通备注、续费提醒等，构成客户时间线
model FollowUp {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// note 普通跟进 / renewal_reminder 续费提醒
  kind           String        @default("note")
  content        String
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([customerId, createdAt])
  @@index([subscriptionId])
}

/// Claude 套餐（Pro / Max / Ultra），记录官方月费用于估算成本
model Plan {
  id                      String          @id @default(cuid())
  code                    String          @unique
  name                    String
  /// 官方月费（美分），例如 2000 = $20
  upstreamMonthlyUsdCents Int
  sort                    Int             @default(0)
  active                  Boolean         @default(true)
  products                Product[]
  subscriptions           Subscription[]
  /// 成品号库存（按套餐分池）
  stockAccounts           ClaudeAccount[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

/// 履约方式：代充 = 充到客户自己的账号；成品号 = 交付公司准备的账号
enum FulfillmentType {
  RECHARGE
  ACCOUNT
}

/// 可售商品 = 套餐 × 服务时长 × 履约方式
model Product {
  id                 String          @id @default(cuid())
  planId             String
  plan               Plan            @relation(fields: [planId], references: [id])
  /// 服务时长（月）：1 月付 / 3 季付 / 12 年付
  termMonths         Int
  fulfillmentType    FulfillmentType
  /// 售价（分）
  priceCents         Int
  /// 加购质保的价格（分）；为空 = 这个商品不提供质保
  warrantyPriceCents Int?
  /// 这个商品单独的佣金比例（万分比）；为空按全局默认，代理单独设置的优先
  firstRateBp        Int?
  renewalRateBp      Int?
  parentRateBp       Int?
  active             Boolean         @default(true)
  orders             Order[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([planId, termMonths, fulfillmentType])
}

enum OrderKind {
  /// 新购：开通新的订阅
  NEW
  /// 续费：延长已有订阅
  RENEWAL
}

enum OrderStatus {
  PENDING_PAYMENT
  /// 已收款，开通 / 续费任务处理中
  FULFILLING
  COMPLETED
  CANCELLED
}

/// 订单 = 一笔交易。下单时把商品信息和价格存成快照，之后改价不影响历史订单
model Order {
  id                  String            @id @default(cuid())
  /// 订单编号，界面显示为 D00001
  no                  Int               @unique @default(autoincrement())
  kind                OrderKind
  status              OrderStatus       @default(PENDING_PAYMENT)
  customerId          String
  customer            Customer          @relation(fields: [customerId], references: [id])
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  /// 续费订单：要延长的订阅；新购订单：开通后回填
  subscriptionId      String?
  subscription        Subscription?     @relation(fields: [subscriptionId], references: [id])
  // ── 快照 ──
  planName            String
  termMonths          Int
  fulfillmentType     FulfillmentType
  listPriceCents      Int
  discountCents       Int               @default(0)
  /// 是否加购了质保（服务期内包换 + 按天退款）
  withWarranty        Boolean           @default(false)
  /// 质保费（分），已含在应收里；默认不退
  warrantyCents       Int               @default(0)
  /// 应收金额（分）= 标价 − 优惠 + 质保费
  amountCents         Int
  paidCents           Int               @default(0)
  /// 已退款合计（分）
  refundedCents       Int               @default(0)
  /// 代充：客户的 Claude 账号（下单时录入）；续费：订阅对应的账号
  accountId           String?
  account             ClaudeAccount?    @relation(fields: [accountId], references: [id])
  accountEmail        String?
  remark              String?
  ownerId             String
  owner               User              @relation("OrderOwner", fields: [ownerId], references: [id])
  teamId              String?
  createdById         String
  createdBy           User              @relation("OrderCreator", fields: [createdById], references: [id])
  payments            Payment[]
  tasks               FulfillmentTask[]
  costEntries         CostEntry[]
  tickets             Ticket[]
  refunds             Refund[]
  /// 这笔订单买到的服务期（开通 / 续费生效时回填），用来把每月上游扣费归到对应订单
  periodStartAt       DateTime?
  periodEndAt         DateTime?
  /// 已发生的成本合计（分），由 CostEntry 汇总
  costCents           Int               @default(0)
  /// 收款手续费合计（分），由 Payment.feeCents 汇总
  feeCents            Int               @default(0)
  // ── 代理与佣金快照（下单时定，之后改比例不影响这笔订单） ──
  agentId             String?
  agent               Agent?            @relation("OrderAgent", fields: [agentId], references: [id])
  /// 是否客户的首单（首单和续费的佣金比例不同）
  firstOrder          Boolean           @default(false)
  /// 直推代理的佣金比例（万分比）
  agentRateBp         Int               @default(0)
  parentAgentId       String?
  parentAgent         Agent?            @relation("OrderParentAgent", fields: [parentAgentId], references: [id])
  /// 上级代理的管理佣金比例（万分比）
  parentRateBp        Int               @default(0)
  /// 佣金基数（分）= 应收，按设置决定是否扣掉质保费
  commissionBaseCents Int               @default(0)
  paidAt              DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([customerId])
  @@index([ownerId])
  @@index([teamId])
  @@index([status, createdAt])
  @@index([agentId])
  @@index([parentAgentId])
}

/// 收款记录。现在由员工手动确认；以后接入支付时，channel / externalId 记录支付平台流水
model Payment {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents   Int
  /// 收款手续费（分），按业务设置里各收款方式的费率计算
  feeCents      Int      @default(0)
  /// wechat / alipay / usdt / bank / other
  method        String
  /// 付款备注或转账单号
  reference     String?
  /// 以后接入支付平台时使用
  channel       String?
  externalId    String?  @unique
  receivedAt    DateTime
  confirmedById String
  confirmedBy   User     @relation(fields: [confirmedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([orderId])
}

/// Claude 账号。代充时是客户自己的号，成品号是公司准备的号；密码等敏感信息加密保存
model ClaudeAccount {
  id              String              @id @default(cuid())
  email           String              @unique
  /// CUSTOMER 客户自己的号 / COMPANY 公司的成品号
  ownership       String
  customerId      String?
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// 加密后的登录密码（AES-256-GCM）
  passwordEnc     String?
  /// 加密后的其他敏感信息（恢复邮箱、备用码等）
  secretNoteEnc   String?
  remark          String?
  /// 成品号库存状态（客户自己的号为空）
  stockStatus     AccountStockStatus?
  /// 成品号对应的套餐，库存按套餐分池
  planId          String?
  plan            Plan?               @relation(fields: [planId], references: [id])
  /// 还没结转到订单的备号成本（分）：备号、在库期间的上游扣费，发号时转到订单
  stockCostCents  Int                 @default(0)
  /// 在库时上游下次扣费时间（已付费到这一天）
  upstreamRenewAt DateTime?
  stockedAt       DateTime?
  subscriptions   Subscription[]
  orders          Order[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([customerId])
  @@index([stockStatus, planId])
}

/// 成品号库存状态
enum AccountStockStatus {
  /// 在库，可以发给客户
  IN_STOCK
  /// 客户使用中
  IN_USE
  /// 作废（封禁、失效）
  VOID
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// 订阅 = 客户某个账号的服务周期，续费提醒、到期风控、内部续费都从这里算
model Subscription {
  id              String             @id @default(cuid())
  /// 订阅编号，界面显示为 S00001
  no              Int                @unique @default(autoincrement())
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  accountId       String
  account         ClaudeAccount      @relation(fields: [accountId], references: [id])
  planId          String
  plan            Plan               @relation(fields: [planId], references: [id])
  fulfillmentType FulfillmentType
  status          SubscriptionStatus @default(ACTIVE)
  /// 服务期：客户付费覆盖的时间段
  startAt         DateTime
  endAt           DateTime
  /// 上游（官方）下次扣费时间。上游按月扣费，季付 / 年付期间每月生成内部续费任务
  upstreamRenewAt DateTime?
  /// 上游是否开着自动续订（我们的付款资源绑在账号上）
  autoRenewOn     Boolean            @default(true)
  /// 负责续费提醒的客服，跟随客户负责人
  ownerId         String
  owner           User               @relation("SubscriptionOwner", fields: [ownerId], references: [id])
  teamId          String?
  orders          Order[]
  tasks           FulfillmentTask[]
  followUps       FollowUp[]
  tickets         Ticket[]
  refunds         Refund[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([customerId])
  @@index([ownerId])
  @@index([teamId])
  @@index([status, endAt])
  @@index([status, upstreamRenewAt])
}

enum TaskType {
  /// 新购开通：代充到客户账号 / 交付成品号
  ACTIVATE
  /// 客户续费：延长服务期
  RENEW
  /// 内部续费：季付 / 年付期间，确保上游每月扣费成功
  INTERNAL_RENEW
  /// 到期未续费：在上游下次扣费前取消自动续订
  CANCEL_AUTO_RENEW
  /// 成品号到期未续费：回收账号
  RECLAIM_ACCOUNT
  /// 售后换号：给客户换一个能用的账号，服务期不变
  REPLACE_ACCOUNT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
  CANCELLED
}

/// 履约任务：充值员的工作队列
model FulfillmentTask {
  id             String        @id @default(cuid())
  /// 任务编号，界面显示为 T00001
  no             Int           @unique @default(autoincrement())
  type           TaskType
  status         TaskStatus    @default(PENDING)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  /// 售后换号任务对应的工单
  ticketId       String?
  ticket         Ticket?       @relation(fields: [ticketId], references: [id])
  assigneeId     String?
  assignee       User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  /// 最晚完成时间
  dueAt          DateTime
  /// 失败次数（失败后可以重新处理）
  attempts       Int           @default(0)
  /// 处理结果或失败原因
  note           String?
  /// 系统自动生成的任务用它去重，例如 INTERNAL_RENEW:订阅ID:2026-12-01
  dedupeKey      String?       @unique
  costEntries    CostEntry[]
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, dueAt])
  @@index([assigneeId, status])
  @@index([subscriptionId])
  @@index([orderId])
  @@index([ticketId])
}

/// 业务设置（键值对）：汇率、提醒节奏、任务时限等
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────── M2 库存与成本 ─────────────────────────────

enum ResourceType {
  /// 虚拟卡（预充值，按美元扣款）
  VIRTUAL_CARD
  /// 礼品卡
  GIFT_CARD
  /// 账户余额
  BALANCE
}

/// 付款资源：给上游（官方）付款用的虚拟卡、礼品卡、余额。
/// 余额按美元记账；入库时记下实际花的人民币，扣费时按加权平均成本结转，得到每单真实成本
model PaymentResource {
  id                 String                @id @default(cuid())
  /// 编号，界面显示为 R00001
  no                 Int                   @unique @default(autoincrement())
  type               ResourceType
  name               String
  /// 卡号后四位等识别信息（不敏感）
  last4              String?
  /// 当前余额（美分）
  balanceUsdCents    Int                   @default(0)
  /// 当前余额对应的人民币成本（分）。平均成本 = costPoolCents / balanceUsdCents
  costPoolCents      Int                   @default(0)
  /// 每笔扣费的手续费：比例（万分比，150 = 1.5%）+ 固定金额（美分）
  feeBp              Int                   @default(0)
  feeFixedUsdCents   Int                   @default(0)
  /// 余额低于这个值时预警（美分）
  lowBalanceUsdCents Int                   @default(0)
  active             Boolean               @default(true)
  /// 加密保存的卡号、CVV、登录信息等
  secretNoteEnc      String?
  remark             String?
  transactions       ResourceTransaction[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

enum ResourceTxType {
  /// 入库 / 充值
  TOP_UP
  /// 上游扣费
  CONSUME
  /// 盘点调整
  ADJUST
}

/// 库存流水：付款资源的每一笔进出
model ResourceTransaction {
  id                   String          @id @default(cuid())
  resourceId           String
  resource             PaymentResource @relation(fields: [resourceId], references: [id])
  type                 ResourceTxType
  /// 美元变动（美分），入为正、出为负；扣费金额已含手续费
  usdCents             Int
  /// 人民币变动（分）：入库 = 实际花费；扣费 = 按平均成本结转（负数）
  cnyCents             Int
  balanceAfterUsdCents Int
  note                 String?
  userId               String
  user                 User            @relation(fields: [userId], references: [id])
  costEntry            CostEntry?
  createdAt            DateTime        @default(now())

  @@index([resourceId, createdAt])
  @@index([createdAt])
}

enum CostKind {
  /// 上游扣费（开通、续费、内部续费）
  UPSTREAM_CHARGE
  /// 成品号备号成本，发号时结转
  ACCOUNT_STOCK
  /// 其他
  OTHER
}

/// 成本记录：归到订单上的每一笔成本，用来算每单毛利
model CostEntry {
  id             String               @id @default(cuid())
  kind           CostKind
  /// 人民币成本（分）
  amountCents    Int
  /// 上游扣费的美元金额（美分，含手续费）
  usdCents       Int?
  orderId        String?
  order          Order?               @relation(fields: [orderId], references: [id])
  subscriptionId String?
  taskId         String?
  task           FulfillmentTask?     @relation(fields: [taskId], references: [id])
  accountId      String?
  resourceTxId   String?              @unique
  resourceTx     ResourceTransaction? @relation(fields: [resourceTxId], references: [id])
  note           String?
  userId         String
  user           User                 @relation(fields: [userId], references: [id])
  createdAt      DateTime             @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// ───────────────────────────── M2 售后与质保 ─────────────────────────────

enum TicketType {
  /// 开通后未生效
  NOT_EFFECTIVE
  /// 封号
  BANNED
  /// 限额 / 降级
  LIMITED
  /// 客户要求退款
  REFUND
  /// 客户要求换号
  REPLACE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  /// 等客户回复（不计超时）
  WAITING_CUSTOMER
  /// 已解决，超过设置的小时数自动关闭
  RESOLVED
  CLOSED
}

/// 售后工单：客户反馈的问题，按类型有处理时限，超时升级；可以换号、补偿天数、申请退款
model Ticket {
  id             String            @id @default(cuid())
  /// 工单编号，界面显示为 G00001
  no             Int               @unique @default(autoincrement())
  type           TicketType
  status         TicketStatus      @default(OPEN)
  customerId     String
  customer       Customer          @relation(fields: [customerId], references: [id])
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id])
  /// 问题发生时服务期覆盖的订单，质保按它算
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id])
  description    String
  /// 客户自身原因（违规使用、自行改密码、自行绑卡等），设置后不在质保内
  customerFault  String?
  /// 处理结果
  resolution     String?
  assigneeId     String?
  assignee       User?             @relation("TicketAssignee", fields: [assigneeId], references: [id])
  /// 跟随客户负责人，用于数据范围
  ownerId        String
  owner          User              @relation("TicketOwner", fields: [ownerId], references: [id])
  teamId         String?
  createdById    String
  createdBy      User              @relation("TicketCreator", fields: [createdById], references: [id])
  /// 处理时限（按类型，见业务设置）
  dueAt          DateTime
  /// 超时升级的时间
  escalatedAt    DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  events         TicketEvent[]
  refunds        Refund[]
  tasks          FulfillmentTask[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, dueAt])
  @@index([assigneeId, status])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([ownerId])
  @@index([teamId])
}

/// 工单时间线：备注、状态变化、换号、补偿、退款、超时升级、自动关闭
model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// created / comment / status / assign / fault / escalated / replace / compensate / refund / resolved / closed / reopened
  kind      String
  content   String?
  /// 系统自动产生的为空
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

enum RefundStatus {
  /// 待审批
  PENDING
  /// 已审批并退款
  PAID
  REJECTED
}

/// 退款：售后申请，财务审批并登记出账。可以选择退款后终止服务（取消自动续订 / 回收成品号）
model Refund {
  id             String        @id @default(cuid())
  /// 退款编号，界面显示为 K00001
  no             Int           @unique @default(autoincrement())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  ticketId       String?
  ticket         Ticket?       @relation(fields: [ticketId], references: [id])
  amountCents    Int
  reason         String
  /// 退款后终止服务
  terminate      Boolean       @default(false)
  status         RefundStatus  @default(PENDING)
  requestedById  String
  requestedBy    User          @relation("RefundRequester", fields: [requestedById], references: [id])
  approvedById   String?
  approvedBy     User?         @relation("RefundApprover", fields: [approvedById], references: [id])
  /// 退款方式与单号（同收款方式）
  method         String?
  reference      String?
  paidAt         DateTime?
  rejectReason   String?
  /// 跟随订单负责人，用于数据范围
  ownerId        String
  teamId         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([orderId])
  @@index([paidAt])
}

// ─────────────── M3 代理与佣金 ───────────────

enum AgentStatus {
  ACTIVE
  /// 停用：不再产生新佣金，已有佣金照常结算
  DISABLED
}

/// 代理：不登录系统，由员工维护资料、代录订单、月底对账。最多两级
model Agent {
  id            String      @id @default(cuid())
  /// 代理编号，界面显示为 A00001
  no            Int         @unique @default(autoincrement())
  name          String
  wechat        String?
  phone         String?
  /// 上级代理；上级本身不能再有上级
  parentId      String?
  parent        Agent?      @relation("AgentTree", fields: [parentId], references: [id])
  children      Agent[]     @relation("AgentTree")
  status        AgentStatus @default(ACTIVE)
  /// 单独设置的佣金比例（万分比），为空按商品或全局默认
  firstRateBp   Int?
  renewalRateBp Int?
  /// 作为上级时，从下级代理的订单里拿的管理佣金比例
  parentRateBp  Int?
  /// 佣金打款方式（alipay / wechat / bank / usdt / other）和账号
  payoutMethod  String?
  payoutAccount String?
  remark        String?
  customers     Customer[]
  orders        Order[]     @relation("OrderAgent")
  parentOrders  Order[]     @relation("OrderParentAgent")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([parentId])
}
